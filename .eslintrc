{
    "root": true,
    "rules": {
        "indent": 0,
        "quotes": [
            2,
            "single"
        ],
        "linebreak-style": [
            2,
            "unix"
        ],
        "semi": [
            2,
            "always"
        ],
        "comma-dangle": [
            2,
            "always-multiline"
        ],
        "no-console": 2
    },
    "env": {
        "node": true,
        "es2022": true
    },
    "globals": {
    },
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "script"
    },
    "overrides": [
        {
            "files": ["test/**/*.js"],
            "env": {
                "mocha": true
            },
            "rules": {
                "no-console": "off"
            }
        },
        {
            "files": ["debug/**/*.js"],
            "rules": {
                "no-console": "off"
            }
        }
    ],
    "extends": "eslint:recommended"
}
