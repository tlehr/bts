    "fixture_games": 584,
    "writes_to_live_bts_or_btp": false,
    "bts_restarted": false,
    "dom_attribution": "MutationObserver with old values; reverse reconstruction detects identical attribute/text writes. Per-game tests also reject foreign row moves and check retained identities.",
    "timing": "Native browser receive queue, unchanged two-animation-frame presented endpoint, no DOM audit instrumentation; 30 repetitions per case after 3 warmups. Status burst sends eight messages per repetition.",
    "scope_limit": "Isolated UI and offline replay, not a live BTS/BTP/device end-to-end or long-duration reliability test."
