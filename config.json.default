{
	"port": 4000,
	"bup_location": "static/bup/downloaded/",
	"bup_index": "index.html",
	"bup_v2_admin_wait_for_score_updates": false,
	"bts_debug_output_enabled": false,
	"bts_server_diagnostics_enabled": false,
	"report_errors": false,
	"enable_https": false,
	"https_port": 4433,
	"https_key": "${PATH_TO}/key.pem",
	"https_cert": "${PATH_TO}/cert.pem"
}
